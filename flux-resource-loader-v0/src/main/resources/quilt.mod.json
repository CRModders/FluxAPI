{
    "schema_version": 1,

    "quilt_loader": {
        "group": "${mod_group}",
        "id": "flux-resource-loader-v0",
        "version": "${mod_version}",

        "intermediate_mappings": "net.fabricmc:intermediary",

        "metadata": {
            "name": "Flux Resource Loader (v0)",
            "description": "Asset and data resource loader.",
            "contributors": {
                "Zombii": "Owner",
                "nanobass": "Developer",
                "coolGi": "Developer",
                "StartsMercury": "Developer"
            },

            "contact": {
                "issues": "https://github.com/CRModders/FluxAPI/issues",
                "sources": "https://github.com/CRModders/FluxAPI"
            },

            "license": "MIT",

            "icon": "assets/flux-resource-loader-v0/icon.png"
        },

        "depends": [
            {
                "id": "cosmicquilt",
                "versions": "*"
            },
            {
                "id": "cosmicreach",
                "versions": ">=${cosmic_reach_version}"
            }
        ]
    },

    "mixin": "flux-resource-loader-v0.mixins.json"
}
